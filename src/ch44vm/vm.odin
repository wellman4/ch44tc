package ch44vm

import "core:fmt"

@(rodata)
chip8_font := []u8 {
	0xF0, 0x90, 0x90, 0x90, 0xF0, // 0
	0x20, 0x60, 0x20, 0x20, 0x70, // 1
	0xF0, 0x10, 0xF0, 0x80, 0xF0, // 2
	0xF0, 0x10, 0xF0, 0x10, 0xF0, // 3
	0x90, 0x90, 0xF0, 0x10, 0x10, // 4
	0xF0, 0x80, 0xF0, 0x10, 0xF0, // 5
	0xF0, 0x80, 0xF0, 0x90, 0xF0, // 6
	0xF0, 0x10, 0x20, 0x40, 0x40, // 7
	0xF0, 0x90, 0xF0, 0x90, 0xF0, // 8
	0xF0, 0x90, 0xF0, 0x10, 0xF0, // 9
	0xF0, 0x90, 0xF0, 0x90, 0x90, // A
	0xE0, 0x90, 0xE0, 0x90, 0xE0, // B
	0xF0, 0x80, 0x80, 0x80, 0xF0, // C
	0xE0, 0x90, 0x90, 0x90, 0xE0, // D
	0xF0, 0x80, 0xF0, 0x80, 0xF0, // E
	0xF0, 0x80, 0xF0, 0x80, 0x80, // F
}

@(rodata)
schip_font := []u8 {
	0x3C, 0x7E, 0xC3, 0xC3, 0xC3, 0xC3, 0xC3, 0xC3, 0x7E, 0x3C, // 0
	0x18, 0x38, 0x58, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x3C, // 1
	0x3E, 0x7F, 0xC3, 0x06, 0x0C, 0x18, 0x30, 0x60, 0x7F, 0x7F, // 2
	0x3C, 0x7E, 0xC3, 0x03, 0x1E, 0x1E, 0x03, 0xC3, 0x7E, 0x3C, // 3
	0x06, 0x0E, 0x1E, 0x36, 0x66, 0xC6, 0x7F, 0x7F, 0x06, 0x06, // 4
	0x7F, 0x7F, 0x60, 0x7C, 0x7E, 0x03, 0x03, 0xC3, 0x7E, 0x3C, // 5
	0x1C, 0x3E, 0x60, 0x7C, 0x7E, 0xC3, 0xC3, 0xC3, 0x7E, 0x3C, // 6
	0x7F, 0x7F, 0x03, 0x06, 0x0C, 0x18, 0x30, 0x30, 0x30, 0x30, // 7
	0x3C, 0x7E, 0xC3, 0xC3, 0x7E, 0x7E, 0xC3, 0xC3, 0x7E, 0x3C, // 8
	0x3C, 0x7E, 0xC3, 0xC3, 0x7F, 0x3F, 0x03, 0x03, 0x7E, 0x3C, // 9
	0x18, 0x3C, 0x66, 0xC3, 0xC3, 0x7F, 0x7F, 0xC3, 0xC3, 0xC3, // A
	0xFC, 0xFE, 0xC3, 0xC3, 0xFC, 0xFC, 0xC3, 0xC3, 0xFE, 0xFC, // B
	0x3C, 0x7E, 0xC3, 0x60, 0x60, 0x60, 0x60, 0xC3, 0x7E, 0x3C, // C
	0xFC, 0xFE, 0xC3, 0xC3, 0xC3, 0xC3, 0xC3, 0xC3, 0xFE, 0xFC, // D
	0x7F, 0x7F, 0x60, 0x60, 0x7C, 0x7C, 0x60, 0x60, 0x7F, 0x7F, // E
	0x7F, 0x7F, 0x60, 0x60, 0x7C, 0x7C, 0x60, 0x60, 0x60, 0x60, // F
}

DISPLAY_WIDTH :: 128
DISPLAY_HEIGHT :: 64

Status :: enum {
	Running,
	Exited,
}

Platform :: enum {
	Chip8,
	Super_Chip,
}

Quirk :: enum {
	Vf_Reset,
	Memory_Increment,
	Vblank_Sync,
	Clipping,
	Shift,
	Jump_With_Offset,
}

Quirks :: bit_set[Quirk]

Vm :: struct {
	// Registers
	v: [16]u8,
	pc: u16,
	sp: u8,
	i: u16,
	// Memory
	mem: [1<<16]u8,
	max_allowed_ram: int,
	stack: [1<<8]u16,
	// Timers
	delay_timer: u8,
	sound_timer: u8,
	// Display
	display: [DISPLAY_WIDTH * DISPLAY_HEIGHT]u8,
	is_display_dirty: bool,
	// Keyboard
	keys: [16]bool,
	last_pressed_key: i8,
	is_waiting_for_key_up: bool,

	status: Status,
	platform: Platform,
	quirks: Quirks,

	// Schip
	display_size: [2]int,
	is_high_res: bool,
	flags: [16]u8,

}

init :: proc(v: ^Vm, platform: Platform, quirks: Quirks, no_font: bool) {
	v.pc = 0x200
	v.display_size = {64, 32}
	v.platform = platform
	v.status = .Running

	switch v.platform {
	case .Chip8:
		v.quirks = { .Vf_Reset, .Vblank_Sync, .Clipping }
		v.max_allowed_ram = 1 << 16
	case .Super_Chip:
		v.quirks = { .Memory_Increment, .Vblank_Sync, .Clipping, .Shift, .Jump_With_Offset }
		v.max_allowed_ram = 1 << 16
	}

	v.quirks ~= quirks

	if !no_font {
		load_bytes(v, chip8_font, 0)
		load_bytes(v, schip_font, u16(len(chip8_font)))
	}
}

destroy :: proc(v: ^Vm) {
}

load_bytes :: proc(v: ^Vm, data: []u8, start_address: u16) -> (ok: bool) {
	end_address := int(start_address) + len(data)

	if end_address > v.max_allowed_ram {
		fmt.eprintf(
			"Error: ROM size exceeds memory limit for platform %v.\n" +
			"Tried to write up to address 0x%X (%d bytes), but max allowed is 0x%X (%d bytes).\n" +
			"[Start: 0x%X, ROM Size: %d bytes]\n",
			v.platform,
			end_address, end_address,
			v.max_allowed_ram, v.max_allowed_ram,
			start_address, len(data),
		)
		return
	}

	copy(v.mem[start_address:end_address], data)

	return true
}
