.text
.org 0x0200

_start:
	call test_mul8
  .busy_wait: j .busy_wait
	
__mul8:
	seqi a1, 0
	j .else
	li a0, 0
	ret
  .else:
	mv t0, a1
	addi t0, 0b1111_1111
	and t0, a1
	seqi t0, 0
	j .else1

  .loop:
	snei a1, 1
	ret
	mv.srl a1, a1
	mv.sll a0, a0
	j .loop

  .else1:
	mv t0, a0
	addi a1, 0b1111_1111
  .loop1:
	snei a1, 0
	ret
	add a0, t0
	addi a1, 0b1111_1111
	j .loop1

assert:
	seq a0, a1
	j .else
	li a0, 1
	ret
  .else:
	li a0, 0
	ret

test_mul8:
	la i, test_mul8_data_set
	lr a0, a0, (i)
	mv t0, a0

	lr v0, v2, (i)
	call __mul8
	mv a1, a2
	call assert
	ret

.data

test_mul8_data_set:
.db 3
.db 5, 4, 20

